{
  "entities": {
    "UserProfile": {
      "title": "Perfil de Usuário",
      "description": "Informações de perfil e permissões do usuário",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "staff"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "Product": {
      "title": "Produto",
      "description": "Cadastro de produtos no estoque",
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "size": { "type": "string" },
        "color": { "type": "string" },
        "gender": { "type": "string" },
        "stock": { "type": "number" },
        "minStock": { "type": "number" },
        "costPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sku", "name", "stock", "costPrice", "salePrice"]
    },
    "Movement": {
      "title": "Movimentação de Estoque",
      "description": "Registro de entrada e saída manual de mercadorias",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "quantity": { "type": "number" },
        "reason": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "type", "quantity", "userId", "timestamp"]
    },
    "Sale": {
      "title": "Venda",
      "description": "Registro de vendas realizadas",
      "type": "object",
      "properties": {
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "fee": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["dinheiro", "pix", "cartão", "transferência"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "clientId": { "type": "string" },
        "customerName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["completed", "cancelled"] },
        "items": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "costPrice": { "type": "number" },
              "quantity": { "type": "number" },
              "total": { "type": "number" }
            }
          }
        }
      },
      "required": ["total", "paymentMethod", "userId", "timestamp", "items"]
    },
    "Client": {
      "title": "Cliente",
      "description": "Cadastro de clientes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "birthDate": { "type": "string" },
        "cpf": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Supplier": {
      "title": "Fornecedor",
      "description": "Cadastro de fornecedores",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "cnpj": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Category": {
      "title": "Categoria / Atributo",
      "description": "Categorias de produtos e atributos (Tamanho, Cor, Gênero)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["categoria", "tamanho", "cor", "gênero"] }
      },
      "required": ["name", "type"]
    },
    "CashSession": {
      "title": "Sessão de Caixa",
      "description": "Abertura e fechamento de caixa diário",
      "type": "object",
      "properties": {
        "openingBalance": { "type": "number" },
        "closingBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "openedAt": { "type": "string", "format": "date-time" },
        "closedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["openingBalance", "status", "userId", "openedAt"]
    },
    "CashMovement": {
      "title": "Movimentação Financeira",
      "description": "Entradas (vendas) e saídas (sangrias) do caixa",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "category": { "type": "string", "enum": ["venda", "sangria", "suprimento"] },
        "paymentMethod": { "type": "string", "enum": ["dinheiro", "pix", "cartão", "transferência"] },
        "reason": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "saleId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["amount", "type", "userId", "timestamp"]
    },
    "Purchase": {
      "title": "Compra / Nota de Entrada",
      "description": "Registro de entrada de mercadorias",
      "type": "object",
      "properties": {
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "fee": { "type": "number" },
        "freight": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["dinheiro", "pix", "cartão", "transferência"] },
        "installments": { "type": "number" },
        "status": { "type": "string", "enum": ["completed", "cancelled"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "note": { "type": "string" },
        "items": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" },
              "total": { "type": "number" }
            }
          }
        }
      },
      "required": ["total", "status", "timestamp", "items"]
    }
  },
  "firestore": {
    "users": { "schema": "UserProfile", "description": "Dados dos usuários cadastrados" },
    "products": { "schema": "Product", "description": "Coleção de produtos do estoque" },
    "movements": { "schema": "Movement", "description": "Histórico de entradas e saídas" },
    "sales": { "schema": "Sale", "description": "Histórico de vendas" },
    "clients": { "schema": "Client", "description": "Cadastro de clientes" },
    "suppliers": { "schema": "Supplier", "description": "Cadastro de fornecedores" },
    "categories": { "schema": "Category", "description": "Lista de categorias para filtros" },
    "cash_sessions": { "schema": "CashSession", "description": "Histórico de aberturas de caixa" },
    "cash_movements": { "schema": "CashMovement", "description": "Histórico de sangrias e entradas" },
    "purchases": { "schema": "Purchase", "description": "Histórico de compras/notas de entrada" }
  }
}
